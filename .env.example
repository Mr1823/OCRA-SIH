# ORCA — Environment Variables
# Copy this file to .env and fill in your values.

# ──────────────────────────────────────────────
#  Groq API (primary LLM provider — fast, generous free tier)
# ──────────────────────────────────────────────
# Free key at https://console.groq.com — no credit card required.
# Free-tier limits are per model. For openai/gpt-oss-120b the binding one
# is tokens per minute (8,000 TPM on the key tested); a query uses ~1,200,
# so bursts beyond ~6 queries/minute get rate-limited (HTTP 429).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ──────────────────────────────────────────────
#  Claude API (Anthropic — fallback LLM provider if Groq is unavailable)
# ──────────────────────────────────────────────
# Get an API key at https://console.claude.com
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ──────────────────────────────────────────────
#  Data source toggle
# ──────────────────────────────────────────────
# Set to "true" for live data: Open-Meteo current conditions and forecasts
# (up to 7 days ahead), IMD alerts, Copernicus chlorophyll.
# Falls back to mock data if Open-Meteo fails.
USE_LIVE_DATA=false

# ──────────────────────────────────────────────
#  Copernicus Marine Service (live chlorophyll-a for PFZ)
# ──────────────────────────────────────────────
# Free account: https://data.marine.copernicus.eu/register
CMEMS_USERNAME=your_cmems_username_here
CMEMS_PASSWORD=your_cmems_password_here

# Sample + score a small grid of nearby points for live PFZ zones.
# Off by default — adds several extra Copernicus + Open-Meteo calls
# per query.
ENABLE_LIVE_PFZ_GRID=false

# ──────────────────────────────────────────────
#  IMD Live Data APIs
# ──────────────────────────────────────────────
# Official IMD API gateway (cyclone_track, seabulletin, coastalbulletin).
# Without a working key, alerts come from built-in sample bulletins and
# every answer says so — including when that sample data has no alerts.
IMD_BASE_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=your_imd_api_key_here
IMD_AUTH_TOKEN=your_imd_jwt_token_here

# ──────────────────────────────────────────────
#  LLM call policy (shared by every provider — see backend/utils/llm.py)
# ──────────────────────────────────────────────
# Retries per call on rate limits (429) and server errors (5xx). A call never
# waits more than LLM_RETRY_WAIT_BUDGET_S in total before the chain moves on
# (Groq → Claude → keyword/template fallback), whatever the first two say.
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_DELAY=0.5
LLM_RETRY_WAIT_BUDGET_S=3.0
# Per-request timeout (SDK defaults: 60 s Groq, 600 s Anthropic)
LLM_REQUEST_TIMEOUT_S=8.0
# Skip a provider for this long after an error retrying can't fix
# (invalid key, "credit balance is too low").
LLM_PROVIDER_COOLDOWN_S=600

# ──────────────────────────────────────────────
#  Server
# ──────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
